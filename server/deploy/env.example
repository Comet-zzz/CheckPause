# Copy this to /etc/checkpause/env and fill in the real values.
#
#   sudo install -m 640 -o checkpause -g checkpause \
#       /etc/checkpause/env.example /etc/checkpause/env
#
# The file is loaded by systemd (EnvironmentFile in the unit) and is never
# committed - keep the real values out of the repository.

# Required. Without it /v1/analyze answers 502 and the status page reports
# "upstream_configured": false.
DEEPSEEK_API_KEY=

# Optional. Defaults shown.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional. The SQLite ledger: accounts, credits, sessions. It holds password
# hashes, so it must stay readable only by the service account - which is what
# the 750 state directory created by install.sh and the systemd unit gives it.
# Back this file up; losing it loses every balance.
CHECKPAUSE_DB=/var/lib/checkpause/checkpause.db

# Optional. Upper bound on one reply, in tokens. Answers are billed by the
# token, so this is what stops a single request from costing an unbounded
# amount. Default 3000.
CHECKPAUSE_MAX_ANSWER_TOKENS=3000

# Optional. Extra credits given on an account's first purchase, as a
# percentage. Ten percent of a CNY 10 top-up means 1100 credits for CNY 10.
# Set to 0 to switch the offer off. Default 10.
CHECKPAUSE_FIRST_TOPUP_BONUS_PERCENT=10
