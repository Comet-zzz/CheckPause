# Copy this to /etc/checkpause/env and fill in the real values.
#
#   sudo install -m 640 -o checkpause -g checkpause \
#       /etc/checkpause/env.example /etc/checkpause/env
#
# The file is loaded by systemd (EnvironmentFile in the unit) and is never
# committed - keep the real values out of the repository.

# Required. Without it /v1/analyze answers 502 and the status page reports
# "upstream_configured": false.
DEEPSEEK_API_KEY=

# Optional. Defaults shown.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional stopgap: when set, requests must carry a matching
# X-CheckPause-Token header. Leave empty to disable the check, which is only
# sensible for local work - it cannot be a real secret while it ships inside a
# desktop client. Real accounts replace it in the next milestone.
CHECKPAUSE_ACCESS_TOKEN=
