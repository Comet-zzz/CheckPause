# Copy this to /etc/checkpause/env and fill in the real values.
#
#   sudo install -m 640 -o checkpause -g checkpause \
#       /etc/checkpause/env.example /etc/checkpause/env
#
# The file is loaded by systemd (EnvironmentFile in the unit) and is never
# committed - keep the real values out of the repository.

# The upstream model provider. Which one is between this deployment and its
# account there, so it is named here rather than anywhere in the repository.
# Any service that speaks the OpenAI protocol will do.
#
# All three are required. Without them /v1/analyze answers 502 and the status
# page reports "upstream_configured": false.
UPSTREAM_API_KEY=
UPSTREAM_BASE_URL=
UPSTREAM_MODEL=

# Optional. The SQLite ledger: accounts, credits, sessions. It holds password
# hashes, so it must stay readable only by the service account - which is what
# the 750 state directory created by install.sh and the systemd unit gives it.
# Back this file up; losing it loses every balance.
CHECKPAUSE_DB=/var/lib/checkpause/checkpause.db

# Optional. Upper bound on one reply, in tokens. Answers are billed by the
# token, so this is what stops a single request from costing an unbounded
# amount. Default 3000.
CHECKPAUSE_MAX_ANSWER_TOKENS=3000

# Optional. Extra credits given on an account's first purchase, as a
# percentage. Ten percent of a CNY 10 top-up means 1100 credits for CNY 10.
# Set to 0 to switch the offer off. Default 10.
CHECKPAUSE_FIRST_TOPUP_BONUS_PERCENT=10

# Optional. How long a sign-in lasts between uses, in seconds. Every request
# pushes the deadline forward, so this bounds an idle session, not a busy one.
# Default 2592000 (30 days).
CHECKPAUSE_TOKEN_TTL_SECONDS=2592000

# Optional. Rate limits for sign-in and sign-up. Signing in runs scrypt, which
# costs real memory and CPU, so these bound both password guessing and the work
# a flood of attempts can cause. Sign-in is limited per client address and per
# account; sign-up per address. Defaults: 10 sign-ins per 60s, 10 sign-ups per
# 3600s.
CHECKPAUSE_LOGIN_ATTEMPTS=10
CHECKPAUSE_LOGIN_WINDOW_SECONDS=60
CHECKPAUSE_REGISTER_ATTEMPTS=10
CHECKPAUSE_REGISTER_WINDOW_SECONDS=3600

# Optional. Like system_prompt.txt but for the two rules that must survive it:
# what to say when asked which model this is (built-in wording in
# server/prompting.py), and the rule against reciting the tuned prompt.
# identity_policy.txt / confidentiality_policy.txt override the built-ins.
#
# Put a tuned prompt at /etc/checkpause/system_prompt.txt. It is the paid
# tier's whole value and must never be committed.
#
# Payment. All four are needed before /v1/pay/orders will do anything; without
# them the endpoint answers 503 and the rest of the service is unaffected.
#
# Get these from the Alipay AI pay console. The key to use here is the one the
# console labels "非 JAVA 语言私钥" - Python signs with PKCS#1, Java with PKCS#8,
# and swapping them fails every signature. The variable name saying "PKCS" is
# not a hint about which format it holds.
AIPAY_APP_ID=
AIPAY_PRIVATE_PKCS_KEY=
AIPAY_ALIPAY_PUBLIC_KEY=

# The sandbox gateway while testing, the openapi.alipay.com one in production.
AIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do

# Optional. Leave BOTH unset until there is a public HTTPS address, and the
# service will confirm payments by trade query instead - which the official
# contract allows and which is also the more reliable of the two. Do not put a
# placeholder or a bare IP here: the contract says to omit the fields rather
# than send an address that goes nowhere.
AIPAY_NOTIFY_URL=
AIPAY_RETURN_URL=

# Optional but recommended. Checked against every notification, so a stranger's
# app_id cannot be used to pay into this account.
AIPAY_SELLER_ID=
