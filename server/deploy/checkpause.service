[Unit]
Description=CheckPause API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=checkpause
Group=checkpause

# Run from the repository root so `server` is importable as a package.
WorkingDirectory=/srv/checkpause
ExecStart=/srv/checkpause/.venv/bin/uvicorn server.app:app --host 127.0.0.1 --port 8000

# The API key and the tuned prompt live outside the checkout; the leading dash
# keeps the unit startable before that file exists.
EnvironmentFile=-/etc/checkpause/env

# The ledger - accounts, credits, password hashes - lives here rather than in
# the checkout, which is mounted read-only below. systemd creates the directory
# owned by the service account; the mode keeps the hashes to that account.
StateDirectory=checkpause
StateDirectoryMode=750

Restart=always
RestartSec=3

# The service never needs to touch anything outside its own directory, except
# for its configuration.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadOnlyPaths=/srv/checkpause

[Install]
WantedBy=multi-user.target
